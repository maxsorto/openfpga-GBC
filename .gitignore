
# Never commit game data: ROMs, BIOS, saves, save states, cover packs or SD card dumps
*.gb
*.gbc
*.sgb
*.sav
*.srm
*.sus
*.iso
covers.bin
covers*.hex
*bios*.bin
sgb_boot.bin

# simulation pack images
tools/sim/*.hex

# the core folders are named like ROM extensions on case-insensitive disks; keep them tracked
!pkg/gbc/Cores/budude2.GBC/
!pkg/gb/Cores/budude2.GB/
